<% layout("/layouts/boilerplate") -%>

<div class="row mt-5">
  <div class="col-md-8 offset-md-2">
    <h2>Confirm your booking</h2>

<div class="card mt-4">
  <div class="card-body">
    <h4><%= listing.title %></h4>

    <hr>

    <p>
      <strong>Check-in:</strong>
      <%= checkIn %>
    </p>

    <p>
      <strong>Check-out:</strong>
      <%= checkOut %>
    </p>

    <p>
      <strong>Number of nights:</strong>
      <%= numberOfNights %>
    </p>

    <p>
      <strong>Price per night:</strong>
      ₹<%= listing.price %>
    </p>

    <h4 class="mt-3">
      Total Price: ₹<%= totalPrice %>
    </h4>

    <form id="payment-form"
          action="/listings/<%= listing._id %>/booking/order"
          method="POST"
          class="mt-4">

      <input type="hidden" name="checkIn" value="<%= checkIn %>">
      <input type="hidden" name="checkOut" value="<%= checkOut %>">

      <button id="pay-button" type="submit" class="btn btn-dark">
        Pay ₹<%= totalPrice %>
      </button>
    </form>

    <p id="payment-message" class="mt-3 text-danger"></p>
  </div>
</div>

  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
  const paymentForm = document.getElementById("payment-form");
  const payButton = document.getElementById("pay-button");
  const paymentMessage = document.getElementById("payment-message");

  paymentForm.addEventListener("submit", async function (event) {
    event.preventDefault();

    payButton.disabled = true;
    payButton.textContent = "Preparing payment...";
    paymentMessage.textContent = "";

    try {
      // Ask our server to create the order.
      const response = await fetch(paymentForm.action, {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          checkIn: paymentForm.checkIn.value,
          checkOut: paymentForm.checkOut.value
        })
      });

      const orderData = await response.json();

      if (!response.ok) {
        throw new Error(orderData.message || "Could not create payment order.");
      }

      // Open Razorpay's secure checkout window.
      const options = {
        key: orderData.key,
        amount: orderData.amount,
        currency: orderData.currency,
        name: "Wanderlust",
        description: "Booking payment for " + orderData.listingTitle,
        order_id: orderData.orderId,

        handler: async function (paymentResponse) {
          try {
            // Send payment details to our server for signature verification.
            const verifyResponse = await fetch("/bookings/verify-payment", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                ...paymentResponse,
                bookingId: orderData.bookingId
              })
            });

            const verifyData = await verifyResponse.json();

            if (!verifyResponse.ok) {
              throw new Error(
                verifyData.message || "Payment verification failed."
              );
            }

            // Navigate only after the server confirms successful verification.
            window.location.href = verifyData.redirectUrl;
          } catch (error) {
            paymentMessage.textContent = error.message;
            payButton.disabled = false;
            payButton.textContent = "Try payment again";
          }
        },

        modal: {
          ondismiss: function () {
            payButton.disabled = false;
            payButton.textContent = "Pay ₹<%= totalPrice %>";
          }
        },

        theme: {
          color: "#212529"
        }
      };

      const razorpay = new Razorpay(options);

      // Handle failed payment attempts.
      razorpay.on("payment.failed", async function (response) {
        paymentMessage.textContent =
          response.error?.description || "Payment failed. Please try again.";

        try {
          const result = await fetch("/bookings/payment-failed", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              bookingId: orderData.bookingId,
              orderId: orderData.orderId
            })
          });

          const data = await result.json();

          if (!result.ok) {
            throw new Error(
              data.message || "Could not save payment failure."
            );
          }

          paymentMessage.textContent =
            "Payment failed. The attempt has been recorded. You can retry.";
        } catch (error) {
          console.error("Failed to record payment status:", error);
          paymentMessage.textContent =
            "Payment failed!";
        }

        payButton.disabled = false;
        payButton.textContent = "Try payment again";
      });

      // Open Checkout after registering the failure handler.
      razorpay.open();

    } catch (error) {
      console.error("Payment initialization failed:", error);
      paymentMessage.textContent = error.message;
      payButton.disabled = false;
      payButton.textContent = "Pay ₹<%= totalPrice %>";
    }
  });
</script>