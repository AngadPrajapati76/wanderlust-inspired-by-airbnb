
<% layout("/layouts/boilerplate") -%>

<div class="container mt-4 mb-5">
  <h2 class="mb-4">
    <i class="fa-regular fa-heart text-danger"></i>
    My Wishlist
  </h2>

  <% if (!wishlist || wishlist.length === 0) { %>
    <div class="text-center py-5">
      <i class="fa-regular fa-heart text-muted"
         style="font-size: 4rem;"></i>

      <h4 class="mt-3">Your wishlist is empty</h4>

      <p class="text-muted">
        Save your favourite stays by clicking the heart icon.
      </p>

      <a href="/listings" class="btn btn-danger mt-2">
        Explore Listings
      </a>
    </div>
  <% } else { %>

    <div class="row row-cols-1 row-cols-sm-2
                row-cols-md-3 row-cols-lg-4 g-4">

      <% wishlist.forEach(item => { %>
        <% if (item.listing) { %>
          <div class="col">
            <div class="card h-100 border-0">

              <a href="/listings/<%= item.listing._id %>"
                 class="text-decoration-none text-dark">

                <img
                  src="<%= item.listing.image?.url || '' %>"
                  class="card-img-top"
                  alt="<%= item.listing.title %>"
                  style="height: 240px; object-fit: cover;
                         border-radius: 12px;">

                <div class="card-body px-0">
                  <h6 class="card-title">
                    <%= item.listing.title %>
                  </h6>

                  <p class="card-text mb-1">
                    <%= item.listing.location || '' %>
                  </p>

                  <p class="card-text">
                    <strong>
                      ₹<%= Number(item.listing.price || 0)
                        .toLocaleString("en-IN") %>
                    </strong> / night
                  </p>
                </div>
              </a>

              <form
                action="/wishlist/<%= item.listing._id %>/toggle"
                method="POST">

                <button type="submit"
                        class="btn btn-outline-danger btn-sm">
                  <i class="fa-solid fa-heart"></i>
                  Remove from Wishlist
                </button>
              </form>

            </div>
          </div>
        <% } %>
      <% }) %>

    </div>
  <% } %>
</div>
